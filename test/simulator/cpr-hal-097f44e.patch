diff --git a/src/common/FsDateTime.h b/src/common/FsDateTime.h
new file mode 100644
index 0000000..86b7c2e
--- /dev/null
+++ b/src/common/FsDateTime.h
@@ -0,0 +1,41 @@
+#pragma once
+// Host shim for SdFat's common/FsDateTime.h: the FAT timestamp packing macros
+// and a no-op callback registry. The simulator's HalStorage is a POSIX
+// directory, so file timestamps come from the host filesystem.
+#include <cstdint>
+
+#define FS_DATE(year, month, day) \
+  static_cast<uint16_t>((((year) - 1980) << 9) | ((month) << 5) | (day))
+#define FS_TIME(hour, minute, second) \
+  static_cast<uint16_t>(((hour) << 11) | ((minute) << 5) | ((second) >> 1))
+#define FS_YEAR(fatDate) static_cast<uint16_t>(1980 + ((fatDate) >> 9))
+#define FS_MONTH(fatDate) static_cast<uint8_t>(((fatDate) >> 5) & 0XF)
+#define FS_DAY(fatDate) static_cast<uint8_t>((fatDate) & 0X1F)
+#define FS_HOUR(fatTime) static_cast<uint8_t>((fatTime) >> 11)
+#define FS_MINUTE(fatTime) static_cast<uint8_t>(((fatTime) >> 5) & 0X3F)
+#define FS_SECOND(fatTime) static_cast<uint8_t>(2 * ((fatTime) & 0X1F))
+
+// SdFat's common/CompileDateTime.h helpers (build date from __DATE__ "Mmm dd yyyy").
+constexpr uint16_t compileYear() {
+  return static_cast<uint16_t>((__DATE__[7] - '0') * 1000 + (__DATE__[8] - '0') * 100 + (__DATE__[9] - '0') * 10 +
+                               (__DATE__[10] - '0'));
+}
+constexpr uint8_t compileDay() {
+  return static_cast<uint8_t>((__DATE__[4] == ' ' ? 0 : (__DATE__[4] - '0') * 10) + (__DATE__[5] - '0'));
+}
+constexpr uint8_t compileMonth() {
+  return __DATE__[0] == 'J' ? (__DATE__[1] == 'a' ? 1 : (__DATE__[2] == 'n' ? 6 : 7))
+         : __DATE__[0] == 'F' ? 2
+         : __DATE__[0] == 'M' ? (__DATE__[2] == 'r' ? 3 : 5)
+         : __DATE__[0] == 'A' ? (__DATE__[1] == 'p' ? 4 : 8)
+         : __DATE__[0] == 'S' ? 9
+         : __DATE__[0] == 'O' ? 10
+         : __DATE__[0] == 'N' ? 11
+                              : 12;
+}
+
+namespace FsDateTime {
+using Callback = void (*)(uint16_t* date, uint16_t* time, uint8_t* ms10);
+inline void setCallback(Callback /*callback*/) {}
+inline void clearCallback() {}
+}  // namespace FsDateTime
