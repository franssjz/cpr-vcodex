 }
 
 bool HalClock::syncFromNTP() { return _available; }
+
+bool HalClock::readUtcTmFromChip(struct tm& outUtc, bool) const {
+  if (!_available) return false;
+  const time_t now = time(nullptr);
+  return gmtime_r(&now, &outUtc) != nullptr;
+}
+bool HalClock::writeUtcTmToChip(const struct tm&) const { return _available; }
+bool HalClock::readUtcTm(struct tm& outUtc, bool forceRefresh) const { return readUtcTmFromChip(outUtc, forceRefresh); }
+bool HalClock::readUtcEpoch(uint32_t& epochSeconds, bool) const {
+  if (!_available) return false;
+  epochSeconds = static_cast<uint32_t>(time(nullptr));
+  return true;
+}
+bool HalClock::writeUtcTm(const struct tm& utc) { return writeUtcTmToChip(utc); }
+bool HalClock::getUtcTime(uint8_t& hour, uint8_t& minute, bool forceRefresh) const {
+  struct tm utc {};
+  if (!readUtcTmFromChip(utc, forceRefresh)) return false;
+  hour = static_cast<uint8_t>(utc.tm_hour);
+  minute = static_cast<uint8_t>(utc.tm_min);
+  return true;
+}
